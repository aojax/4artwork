---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import {getEntry,render} from 'astro:content';
const entry=await getEntry('research','deepart');if(!entry)throw new Error('DeepArt content missing');const {Content}=await render(entry);
---
<BaseLayout title="DeepArt · 理解艺术的价值" description="以证据为基础的艺术知识与研究系统。连接资料、比较分析与专业人员的判断。">
  <section class="detail-hero"><div class="wrap"><div class="breadcrumbs"><a href="/">4ART.WORK</a><span>/</span><span>DeepArt</span></div><div class="detail-hero-grid"><div><p class="eyebrow">DEEPART / KNOWLEDGE & INSIGHT</p><h1>理解艺术，<br />从<span class="serif orange">更好的问题</span>开始。</h1><p class="lead">连接艺术知识、原始资料与比较研究。<br />让 AI 协助寻找依据，让人作出有分寸的判断。</p><a href="#research" class="button button-dark">探索研究过程 <Icon name="arrow" /></a></div><div class="detail-art"><div class="path-art wave-art" aria-hidden="true">{Array.from({length:23},(_,i)=><i style={`--i:${i};--wave:${Math.sin(i/2)*38+60}px`}></i>)}</div></div></div></div></section>
  <div class="wrap"><nav class="subnav" aria-label="DeepArt 页面导航"><a href="#research">研究准备度</a><a href="#method">方法与边界</a><a href="#roadmap">建设路径</a><a href="#contact">研究合作</a></nav></div>
  <section class="section wrap" id="research"><SectionHeading number="01" label="EVIDENCE BEFORE ANSWERS" title="资料越清楚，问题越有方向。" description="拖动滑块，看看资料完整度如何影响研究准备。数值为教学示意，不代表真实数据、置信度或作品价格。" /><div class="research-demo"><div><span class="pill">交互示意 · 非估值模型</span><h3>在给出答案之前，<br />先看看我们知道多少。</h3><p>作品身份、来源记录与比较材料，是不同层次的研究基础。任意一项不足，都需要回到资料补充。</p><div class="research-control"><label for="coverage">假设资料完整度 <output id="coverage-value" for="coverage">60%</output></label><input id="coverage" type="range" min="10" max="100" step="5" value="60" /></div></div><div class="research-chart" aria-label="示意研究准备程度"><div class="bar-row"><span>基本信息整理</span><div class="bar-track"><span data-bar="0" style="width:60%"></span></div><span data-bar-label="0">60%</span></div><div class="bar-row"><span>来源材料组织</span><div class="bar-track"><span data-bar="1" style="width:51%"></span></div><span data-bar-label="1">51%</span></div><div class="bar-row"><span>比较问题准备</span><div class="bar-track"><span data-bar="2" style="width:37%"></span></div><span data-bar-label="2">37%</span></div><div class="research-summary" id="research-summary" role="status">资料正在完善：可以梳理研究问题，比较样本仍需核验和补充。</div></div></div></section>
  <section class="wrap" id="method"><SectionHeading number="02" label="THINKING WITH EVIDENCE" title="让分析可以被理解，也可以被追问。" /><div class="prose"><Content /></div></section>
  <section class="section wrap" id="roadmap"><SectionHeading number="03" label="BUILDING WITH CARE" title="先把基础做实，再走向更远。" description="按条件推进的建设路径。以下为规划，不代表阶段已完成或服务已经开放。" /><div class="roadmap"><div><p class="eyebrow">PHASE 0</p><h3>资料与证据</h3><p>梳理原始材料、作品字段与授权。建立少量可复核的样本，记录缺项和分歧。</p><span class="pill">进入条件：来源与范围明确</span></div><div><p class="eyebrow">PHASE 1</p><h3>知识与比较</h3><p>提供有出处的检索和候选材料，检验样本对应关系与比较理由。</p><span class="pill">进入条件：样本通过复核</span></div><div><p class="eyebrow">PHASE 2</p><h3>分析与协作</h3><p>在资料和方法充分时，探索专家参与的分析服务与受控接入。</p><span class="pill">进入条件：方法经过验证</span></div></div><div class="related-links"><a href="/queyuan/">了解确源的证据档案 <Icon name="northeast" /></a><a href="/csc-art-ai/">探索 CSC 的人机共创 <Icon name="northeast" /></a></div></section>
</BaseLayout>
