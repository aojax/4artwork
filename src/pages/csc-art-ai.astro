---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import {getEntry,render} from 'astro:content';
const entry=await getEntry('research','csc');
if(!entry)throw new Error('CSC content missing');
const {Content}=await render(entry);
const features=[{id:'archive',icon:'book',title:'我的艺术档案',desc:'把个人经历、口述、手稿与作品资料，整理成可以持续积累的创作记忆。',output:'个人简介 / 作品卡 / 创作年表'},{id:'writing',icon:'pen',title:'自媒体助手',desc:'从作品故事出发，组织选题、图文与口播稿，让表达保留你的语气。',output:'公众号 / 小红书 / 口播稿'},{id:'design',icon:'image',title:'AI 设计台',desc:'围绕原有作品与草图，探索纹样、配色、包装和展陈的不同可能。',output:'概念草案 / 海报 / 视觉方案'},{id:'video',icon:'video',title:'视频工作室',desc:'把真实拍摄与本人讲述编成故事，逐步连接分镜、字幕、剪辑与成片。',output:'作品短片 / 工序记录 / 人物故事'},{id:'exhibition',icon:'grid',title:'展览与传播',desc:'围绕一次展览、课程或交流，组织一致的作品介绍和传播材料。',output:'作品集 / 展签 / 中英文简介'},{id:'collection',icon:'folder',title:'我的成果库',desc:'把确认后的文稿、图像、视频和修改记录留在一起，让下一次从积累开始。',output:'成果归档 / 版本记录 / 素材包'}];
---
<BaseLayout title="CSC 实验室与 AI 奥杰" description="AI 奥杰，艺术家的 AI 工作室。CSC 艺术人工智能实验室探索知识整理、自媒体、辅助设计与视频制作。">
  <section class="detail-hero"><div class="wrap"><div class="breadcrumbs"><a href="/">4ART.WORK</a><span>/</span><span>CSC 艺术人工智能</span></div><div class="detail-hero-grid"><div><p class="eyebrow"><span class="status-dot"></span> CSC ARTIFICIAL INTELLIGENCE LAB</p><h1>让人的创造力，<br />拥有<span class="serif orange">新的伙伴。</span></h1><p class="lead">面向艺术与文化数字化的研究实践。<br />从创作者的真实问题出发，把 AI 带进工作室。</p><a href="#studio" class="button button-dark">认识 AI 奥杰 <Icon name="arrow" /></a></div><div class="detail-art"><div class="path-art orbit-art" aria-hidden="true"><div></div><div></div><div></div><i>✳</i></div></div></div></div></section>
  <div class="wrap"><nav class="subnav" aria-label="实验室页面导航"><a href="#studio">AI 奥杰</a><a href="#workflow">创作流程</a><a href="#workbench">任务单体验</a><a href="#method">研究方法</a><a href="#collaborate">共创计划</a></nav></div>
  <section class="wrap" id="studio"><div class="detail-intro">你带来一生积累的<span>技艺与感受</span>，<br />AI 协助把它们变成更多人能看见的表达。</div><SectionHeading number="01" label="AI AOJIE STUDIO" title="AI 奥杰 · 艺术家的 AI 工作室" description="面向艺术家、中国工艺美术大师、手艺人和非遗传承者。以下为六个拟建设的工作空间，当前可体验创作任务单。" /><div class="feature-grid">{features.map(f=><article id={f.id} class="feature-card"><div class="feature-icon"><Icon name={f.icon} size={27} /></div><h3>{f.title}</h3><p>{f.desc}</p><span class="pill">{f.output}</span></article>)}</div></section>
  <section class="section wrap" id="workflow"><SectionHeading number="02" label="FROM YOUR WORK, TO THE WORLD" title="从一件作品，到多种表达。" description="工具围绕你的任务工作。每一步都能修改，每一份输出都由你确认。" /><div class="workflow"><div><span class="step-number">01</span><h3>带来你的素材</h3><p>一段口述、一组照片、一份手稿。先记录真实，再组织表达。</p></div><div><span class="step-number">02</span><h3>找到表达方向</h3><p>确定是作品故事、设计探索，还是一分钟的技艺短片。</p></div><div><span class="step-number">03</span><h3>与 AI 一起推敲</h3><p>让工具辅助整理和尝试，把准确性、风格与工艺判断留给人。</p></div><div><span class="step-number">04</span><h3>把成果留在手里</h3><p>确认后再导出，保存原始材料与修改记录，继续下一次创作。</p></div></div></section>
  <section class="workbench-section" id="workbench"><div class="wrap"><SectionHeading number="03" label="TRY A SMALL BEGINNING" title="先为你的作品，做一份任务单。" description="本地模板体验：填写素材，即可整理并下载制作任务单。无需登录，不上传内容，不调用云端 AI。" /><div class="workbench"><form id="brief-form" class="brief-form"><h3>从你的作品开始</h3><p class="form-note">把你已知的写下来，不确定的可以留待补充。</p><label class="field"><span>作品或项目名称</span><input name="work" maxlength="80" required placeholder="例如：一只留有手工痕迹的茶碗" autocomplete="off" /></label><label class="field"><span>你的创作领域</span><select name="medium"><option>陶瓷与紫砂</option><option>书画与视觉艺术</option><option>织绣与服饰</option><option>雕刻与木作</option><option>非遗与传统工艺</option><option>其他艺术实践</option></select></label><label class="field"><span>想讲述的故事或制作细节</span><textarea name="story" required maxlength="2000" placeholder="这件作品因何而作？用了什么材料？哪个细节最想让人看见？"></textarea></label><label class="field"><span>这次想做什么？</span><select name="output"><option value="article">一篇作品图文</option><option value="design">一份设计方案</option><option value="video">一条一分钟视频</option></select></label><button class="button button-dark" type="submit">整理创作任务单 <Icon name="arrow" /></button><p class="privacy-note" id="brief-status" role="status">内容仅在当前页面处理，刷新或离开后不保存。</p><noscript><p class="privacy-note">任务单需要启用 JavaScript。也可以直接联系页面底部邮箱，交流创作需求。</p></noscript></form><div class="brief-result"><div class="result-topline"><span>YOUR NEXT CREATION</span><span>人主导 · 工具辅助</span></div><div id="result-empty"><div class="result-empty-art" aria-hidden="true">✳</div><h3>一个小小的开始，<br />也能长出新的可能。</h3><p>你的任务单将包括：</p><ol><li>整理后的原始素材</li><li>适合本次任务的制作结构</li><li>发布前的人工确认清单</li></ol><p class="privacy-note">这是一份可执行的创作准备单，图片与视频制作功能仍在建设中。</p></div><div id="result-content" tabindex="-1" hidden><h3 id="result-title"></h3><pre id="result-text"></pre><button id="download-brief" class="button button-dark" type="button">下载任务单 <Icon name="download" size={17} /></button></div></div></div></div></section>
  <section class="section wrap" id="method"><SectionHeading number="04" label="HUMAN KNOWLEDGE, SHARED POSSIBILITY" title="让工具理解你，先从你的知识开始。" /><div class="prose"><Content /></div></section>
  <section class="section wrap collaborate" id="collaborate"><div><p class="eyebrow">LET'S BUILD IT TOGETHER</p><h2>寻找认真创作的人，<br />一起把工具做得更好。</h2><p>首期计划与 5 位不同领域的创作者共创。从一件作品出发，打磨图文、设计与视频的完整制作过程。欢迎带着你的需求与素材情况来交流。</p><a href="mailto:olachina@qq.com?subject=AI%E5%A5%A5%E6%9D%B0%E5%85%B1%E5%88%9B%E8%AE%A1%E5%88%92" class="button button-dark">邮件联系共创 <Icon name="northeast" /></a></div><div class="faq"><details open><summary>需要先学会复杂的软件吗？</summary><p>目标是用清楚的任务入口降低学习门槛。当前任务单支持手机浏览器，个人知识库和工作室插件将按试点需求逐步接入。</p></details><details><summary>AI 会替我决定作品怎么做吗？</summary><p>创作方向、工艺可行性、署名与最终发布内容都由你确认。AI 协助整理、探索与制作。</p></details><details><summary>现在已经可以生成图片和视频了吗？</summary><p>当前站点可整理并下载创作任务单。云端生图、视频生成、自动剪辑、账号与素材同步尚未接入。后续开放时会说明功能范围和费用。</p></details><details><summary>作品资料会被用于 AI 训练吗？</summary><p>当前演示不上传资料。后续服务的公开展示、AI 处理和训练使用将分别征求授权，不以上传资料作为自动同意。</p></details></div></section>
</BaseLayout>
