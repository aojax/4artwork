---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import {getEntry,render} from 'astro:content';
const entry=await getEntry('research','queyuan');if(!entry)throw new Error('Queyuan content missing');const {Content}=await render(entry);
---
<BaseLayout title="确源 · 让来处有迹可循" description="从一物一档出发，探索确真、确权、确源（溯源）、确价的证据组织方法。">
  <section class="detail-hero"><div class="wrap"><div class="breadcrumbs"><a href="/">4ART.WORK</a><span>/</span><span>确源</span></div><div class="detail-hero-grid"><div><p class="eyebrow">QUEYUAN / PROVENANCE & TRUST</p><h1>每一件作品，<br />都值得拥有<span class="serif orange">清楚的来历。</span></h1><p class="lead">从源头的记录，到流转的痕迹。<br />让作品的故事，与可以追溯的证据一起留下。</p><a href="#four-q" class="button button-dark">探索四确方法 <Icon name="arrow" /></a></div><div class="detail-art"><div class="path-art source-art" aria-hidden="true"><span></span><span></span><span></span><i>源</i></div></div></div></div></section>
  <div class="wrap"><nav class="subnav" aria-label="确源页面导航"><a href="#four-q">四确方法</a><a href="#architecture">证据如何连接</a><a href="#method">档案原则</a><a href="#pilot">试点方向</a></nav></div>
  <section class="section wrap" id="four-q"><SectionHeading number="01" label="FOUR QUESTIONS, ONE WORK" title="四个问题，认真回答。" description="四确：确真、确权、确源（溯源）、确价。点击每一项，了解一份作品档案需要保留什么。" /><div class="evidence-demo"><div class="evidence-heading"><span class="pill">方法演示 · 非鉴定结果</span><h3>信任来自证据，<br />也来自清楚的边界。</h3><p>不同问题需要不同材料。档案中的每一个判断，都应该能找到依据与负责的人。</p><div class="evidence-switches" role="group" aria-label="选择四确维度"><button data-evidence="authenticity" aria-pressed="true">确真</button><button data-evidence="rights" aria-pressed="false">确权</button><button data-evidence="provenance" aria-pressed="false">确源</button><button data-evidence="value" aria-pressed="false">确价</button></div></div><div class="evidence-record" aria-live="polite"><p class="eyebrow">EVIDENCE NOTES</p><h4 data-evidence-title>确真：谁来判断，依据是什么？</h4><p data-evidence-description>将作品本体信息、观察记录与专家意见分开留存，明确判断主体和适用范围。</p><ul data-evidence-list><li>作品图像、尺寸、材质与观察条件</li><li>检测或专家意见的来源、时间和范围</li><li>存在分歧或尚缺的证据</li></ul></div></div></section>
  <section class="wrap" id="architecture"><SectionHeading number="02" label="HOW EVIDENCE CONNECTS" title="每一条信息，都有来处。" /><div class="architecture"><div><h3>原始材料</h3><p>作品图像、文件与事件凭证</p></div><span aria-hidden="true">→</span><div><h3>作品档案</h3><p>结构化字段与来源链接</p></div><span aria-hidden="true">→</span><div><h3>人工复核</h3><p>记录分歧、补充与意见</p></div><span aria-hidden="true">→</span><div><h3>按范围公开</h3><p>查询、更新与修订历史</p></div></div></section>
  <section class="section wrap" id="method"><SectionHeading number="03" label="A LIVING RECORD" title="档案不是终点，而是持续的记录。" /><div class="prose"><Content /></div></section>
  <section class="section wrap collaborate" id="pilot"><div><p class="eyebrow">A SMALL, COMPLETE BEGINNING</p><h2>从少量真实作品，<br />走通一次完整记录。</h2><p>面向创作者、收藏与文化机构，探索建档、材料核对、人工复核和公开查询的小范围试点。合作范围与资料使用方式在试点前明确。</p><a href="mailto:olachina@qq.com?subject=%E7%A1%AE%E6%BA%90%E4%BD%9C%E5%93%81%E6%A1%A3%E6%A1%88%E8%AF%95%E7%82%B9" class="button button-dark">交流试点需求 <Icon name="northeast" /></a></div><div class="faq"><details open><summary>有数字档案，就等于鉴定完成了吗？</summary><p>不等于。档案组织材料与记录，鉴定需要具备相应条件的专业判断。页面查询、二维码或数字标签本身不能替代鉴定结论。</p></details><details><summary>目前有哪些已经上线的服务？</summary><p>本页提供四确方法交互展示。作品管理后台、对外存证接口与正式报告服务尚未在本站开放。</p></details><details><summary>如何提出补充或纠正？</summary><p>可通过页面底部联系邮箱说明对应内容、补充材料及来源。公开档案服务建立后，将设置记录内的修订入口。</p></details></div></section>
</BaseLayout>
