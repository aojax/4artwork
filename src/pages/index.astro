---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LivingArt from '../components/LivingArt.astro';
import SectionHeading from '../components/SectionHeading.astro';


const tools = [{icon:'pen',title:'把故事，讲给更多人',tag:'自媒体创作',desc:'从一段口述到一篇文章，让作品背后的想法被听见。'},{icon:'image',title:'让灵感，多一种可能',tag:'AI 辅助设计',desc:'纹样、配色、包装与展陈，陪你探索下一种表达。'},{icon:'video',title:'把手艺，留在镜头里',tag:'AI 视频工作室',desc:'用真实的制作片段，组织故事、分镜与传播素材。'}];
---
<BaseLayout>
  <section class="hero wrap" id="hero">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow"><span class="status-dot"></span> ART × HUMAN × AI</p>
      <h1>让艺术与智能，<br /><span class="serif orange">共同生长</span><span class="orange title-stop">。</span></h1>
      <p class="hero-description">人的灵感，手的温度，智能的可能。<br />在艺术与技术之间，探索有生命力的未来。</p>
      <div class="hero-actions"><a href="/csc-art-ai/#studio" class="button button-dark">遇见 AI 奥杰 <Icon name="northeast" size={18} /></a><a class="quiet-link" href="#explore">探索我们的实践 <span>↓</span></a></div>
      <div class="hero-footnote"><span class="tiny-spark">✳</span><span>以人的创造为起点<br /><small>A HUMAN-CENTERED CREATIVE FUTURE</small></span></div>
    </div>
    <div class="hero-art-frame"><span class="art-corner top-left">FIG. 001 — SYMBIOSIS</span><LivingArt hero /><span class="art-caption">《共生》<span>AI 生成概念艺术 / 2026</span></span><div class="art-seal" aria-hidden="true"><span>FOR ART<br />FOR LIFE</span><b>↗</b></div></div>
  </section>
  <div class="manifesto-strip"><div class="wrap"><span>艺术的未来，始终关于人。</span><div><span>ART</span><b>✳</b><span>CRAFT</span><b>✳</b><span>INTELLIGENCE</span><b>✳</b><span>POSSIBILITY</span></div><a href="#explore" aria-label="向下探索">↓</a></div></div>
  <section class="section wrap" id="explore">
    <SectionHeading number="01" label="OUR EXPLORATIONS" title="三条路径，同一种好奇心。" description="从研究到创作，从证据到理解。让艺术经验与机器智能，在具体的实践中相遇。" />
    <div class="path-grid">
      <a class="path-card path-lab" href="/csc-art-ai/"><div class="path-meta"><span>RESEARCH & CREATION</span><Icon name="northeast" /></div><div class="path-art orbit-art" aria-hidden="true"><div></div><div></div><div></div><i>✳</i></div><p class="eyebrow">01 / CSC LAB</p><h3>CSC人工智能实验室</h3><p>让研究走进工作室，让智能成为创作者的新工具。</p><div class="path-bottom"><span>艺术智能 · AI 奥杰 · 共创实验</span><span>探索实验室 ↗</span></div></a>
      <a class="path-card path-source" href="/queyuan/"><div class="path-meta"><span>PROVENANCE & TRUST</span><Icon name="northeast" /></div><div class="path-art source-art" aria-hidden="true"><span></span><span></span><span></span><i>源</i></div><p class="eyebrow">02 / QUEYUAN</p><h3>确源 · 让来处有迹可循</h3><p>为作品整理可追溯的证据，让每一段来历被认真对待。</p><div class="path-bottom"><span>四确体系 · 作品档案 · 证据链</span><span>走进确源 ↗</span></div></a>
      <a class="path-card path-deep" href="/deepart/"><div class="path-meta"><span>KNOWLEDGE & INSIGHT</span><Icon name="northeast" /></div><div class="path-art wave-art" aria-hidden="true">{Array.from({length:17},(_,i)=><i style={`--i:${i};--wave:${Math.sin(i/2)*38+60}px`}></i>)}</div><p class="eyebrow">03 / DEEPART</p><h3>DeepArt · 理解艺术的价值</h3><p>连接知识、证据与人的判断，让艺术研究有据可依。</p><div class="path-bottom"><span>知识检索 · 比较研究 · 专家复核</span><span>了解 DeepArt ↗</span></div></a>
    </div>
  </section>
  <section class="studio-section" id="ai-aojie"><div class="wrap">
    <div class="studio-intro"><div><p class="eyebrow light"><span class="status-dot"></span> INTRODUCING AI AOJIE</p><h2>你的手艺，<br />值得被世界<span class="serif peach">看见。</span></h2></div><div><span class="pill pill-light">CSC人工智能实验室 · 共创中的产品</span><p>AI 奥杰，艺术家的 AI 工作室。<br />陪艺术家、工艺美术大师、手艺人和非遗传承者，<br class="desktop-only" />把积累变成故事，把灵感变成新的表达。</p><a class="text-link light" href="/csc-art-ai/#studio">认识 AI 奥杰 <Icon name="northeast" /></a></div></div>
    <div class="tool-grid">{tools.map((tool,i)=><a href={`/csc-art-ai/#${['writing','design','video'][i]}`} class="tool-card"><div class="tool-icon"><Icon name={tool.icon} size={26} /></div><span class="tool-number">0{i+1}</span><p class="tool-tag">{tool.tag}</p><h3>{tool.title}</h3><p>{tool.desc}</p><span class="tool-arrow"><Icon name="northeast" /></span></a>)}</div>
    <div class="studio-bottom"><p><span>从你的作品出发</span><span>保留你的风格</span><span>由你作最终判断</span></p><a href="/csc-art-ai/#workbench" class="button button-cream">试做一份创作任务单 <Icon name="arrow" size={18} /></a></div>
  </div></section>
  <section class="section wrap" id="practice">
    <SectionHeading number="02" label="A DIFFERENT WAY OF SEEING" title="一件作品，不止一种观看。" description="好的技术，让我们看得更细，也问得更深。试着切换视角，看看创作、证据与研究如何连接。" />
    <div class="exhibit" data-tabs>
      <div class="exhibit-visual"><LivingArt /><div class="exhibit-caption"><span>共生 / SYMBIOSIS</span><span>概念演示 · 非实物档案</span></div></div>
      <div class="exhibit-info"><div class="tab-list" role="tablist" aria-label="观看作品的方式"><button role="tab" id="view-art" aria-selected="true" aria-controls="panel-art" data-tab="art">作品</button><button role="tab" id="view-evidence" aria-selected="false" aria-controls="panel-evidence" tabindex="-1" data-tab="evidence">证据</button><button role="tab" id="view-research" aria-selected="false" aria-controls="panel-research" tabindex="-1" data-tab="research">研究</button></div>
      <div id="panel-art" role="tabpanel" aria-labelledby="view-art" data-panel="art" tabindex="0"><p class="eyebrow">01 / THE WORK</p><h3>在褶皱之间，<br />看见生长的形状。</h3><p>纸的轻盈、陶的温润与植物舒展的节律，在一条连续的环带中相遇。这是为 4ART.WORK 创作的 AI 概念视觉。</p><dl><div><dt>媒介</dt><dd>AI 生成数字图像</dd></div><div><dt>创作方向</dt><dd>有机形态 × 工艺质感</dd></div><div><dt>人工参与</dt><dd>视觉命题、选择与编排</dd></div></dl></div>
      <div id="panel-evidence" role="tabpanel" aria-labelledby="view-evidence" data-panel="evidence" tabindex="0" hidden><p class="eyebrow">02 / THE EVIDENCE</p><h3>让已知与未知，<br />都被清楚记录。</h3><p>本图由 AI 生成，用于网站概念展示。它不是已完成的实物作品，也没有对应的鉴定证书或交易记录。</p><dl><div><dt>来源</dt><dd>本站视觉创作记录</dd></div><div><dt>作品状态</dt><dd>数字概念图 · 非实物</dd></div><div><dt>档案边界</dt><dd>不作鉴真或市场价格依据</dd></div></dl><a href="/queyuan/" class="text-link">了解证据档案 <Icon name="northeast" /></a></div>
      <div id="panel-research" role="tabpanel" aria-labelledby="view-research" data-panel="research" tabindex="0" hidden><p class="eyebrow">03 / THE QUESTIONS</p><h3>AI 提供可能，<br />人保留判断。</h3><p>这样的形态能否被陶瓷工艺实现？薄壁结构如何支撑？数字图像中的材料表现，与真实烧制效果有多大距离？</p><dl><div><dt>AI 辅助</dt><dd>形态探索与视觉变体</dd></div><div><dt>人工判断</dt><dd>审美、材料与工艺可行性</dd></div><div><dt>下一步</dt><dd>由创作者进行实物试验</dd></div></dl><a href="/deepart/" class="text-link">探索研究方法 <Icon name="northeast" /></a></div>
      </div>
    </div>
  </section>
  <section class="journal-section section wrap" id="journal">
    <SectionHeading number="03" label="NOTES & IDEAS" title="保持提问，持续生长。"><a class="text-link" href="https://aojie.space/posts/" target="_blank" rel="noopener noreferrer">全部研究笔记 <Icon name="northeast" /></a></SectionHeading>
    <div class="journal-list"><a href="https://aojie.space/posts/crackdown-on-fake-certificates-traditional-crafts-2026/" target="_blank" rel="noopener noreferrer"><span class="journal-category">标准与信任</span><h3>传统工艺市场“打假清源”：让信任回到证据</h3><span class="journal-source">林奥杰 · 研究笔记</span><Icon name="northeast" /></a><a href="https://aojie.space/posts/nft-ownership-three-layers/" target="_blank" rel="noopener noreferrer"><span class="journal-category">文化数字资产</span><h3>数字作品的持有、使用与版权，如何区分？</h3><span class="journal-source">林奥杰 · 研究笔记</span><Icon name="northeast" /></a><a href="/csc-art-ai/#method"><span class="journal-category">人机共创</span><h3>让 AI 理解你的创作，从一份个人知识库开始</h3><span class="journal-source">AI 奥杰 · 方法设计</span><Icon name="northeast" /></a></div>
  </section>
  <section class="about-section wrap" id="about"><div class="about-portrait"><img src="/art/lin-aojie-600.webp" alt="林奥杰在华东师范大学演讲" width="600" height="400" decoding="async" loading="lazy" /><span>林奥杰 / LIN AOJIE</span></div><div class="about-copy"><p class="eyebrow">THE HUMAN BEHIND THE WORK</p><h2>把艺术放在心里，<br />把问题带向未来。</h2><p>我是林奥杰，关注艺术金融、文化数字资产、艺术品鉴证溯源与艺术人工智能。</p><p>4ART.WORK 是这些研究与实践相遇的地方。我希望技术能够尊重创作者的经验，让手艺被记录，让作品被理解，也让新的创造自然发生。</p><a class="text-link" href="https://aojie.space/about/" target="_blank" rel="noopener noreferrer">更多关于我 <Icon name="northeast" /></a></div><span class="about-asterisk" aria-hidden="true">✳</span></section>
</BaseLayout>
