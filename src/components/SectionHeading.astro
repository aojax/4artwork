---
interface Props { number: string; label: string; title: string; description?: string; }
const {number,label,title,description} = Astro.props;
---
<div class="section-heading"><div><p class="eyebrow"><span>{number}</span> / {label}</p><h2>{title}</h2></div>{description && <p class="section-description">{description}</p>}<slot /></div>
