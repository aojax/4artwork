---
import { Image } from 'astro:assets';
import art from '../assets/living-form.png';
interface Props { hero?: boolean; class?: string; }
const { hero = false, class: className = '' } = Astro.props;
---
<div class:list={['living-art', className]}>
  <Image src={art} alt="生长中的褶皱：朱橙与青瓷色的有机环带，像花与纸雕共同舒展。AI 生成概念艺术。" widths={[480, 800, 1200, 1536]} sizes={hero ? '(max-width: 760px) 100vw, 60vw' : '(max-width: 760px) 100vw, 50vw'} format="webp" quality={85} loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} />
</div>
